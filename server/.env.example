# JWT Secrets
JWT_SECRET=scancart_jwt_super_secret_production_key_2026_change_in_prod
JWT_EXPIRES_IN=7d

# Receipt Cryptographic Signature Secret
RECEIPT_SECRET=scancart_hmac_sha256_receipt_secret_key_84920491

# Razorpay Test Keys (Mock / Test mode)
RAZORPAY_KEY_ID=rzp_test_mockKeyId12345
RAZORPAY_KEY_SECRET=mockKeySecretValue98765
RAZORPAY_WEBHOOK_SECRET=mockWebhookSecretValue123
